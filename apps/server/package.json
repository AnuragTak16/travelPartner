{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/node.ts --outfile server",
    "dev": "tsx watch src/node.ts",
    "start": "node dist/node.mjs",
    "deploy": "wrangler deploy",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- pnpm dlx auth@latest generate --config src/auth.cli.ts --output ../../packages/db/prisma/schema/auth.prisma --yes"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@hono/trpc-server": "^0.4.2",
    "@travelPartner/api": "workspace:*",
    "@travelPartner/auth": "workspace:*",
    "@travelPartner/db": "workspace:*",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "hono": "^4.13.11",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@travelPartner/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "unrun": "^0.3.1",
    "wrangler": "^4.145.0"
  }
}
