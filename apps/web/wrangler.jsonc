{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "travelpartner-web",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  // Monorepo: Cloudflare Workers Builds must use the repo root so
  // pnpm-lock.yaml is detected (catalog: + workspace:* require pnpm).
  // Dashboard settings:
  //   Root directory: /
  //   Build command:  pnpm install && pnpm run build
  //   Deploy command: pnpm exec wrangler deploy -c apps/web/wrangler.jsonc
  //   Env (optional): PACKAGE_MANAGER=pnpm
  "build": {
    "command": "pnpm run build",
    "cwd": "../.."
  }
}
